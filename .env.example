APP_NAME="Zen Cart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://filagora-zencart-site.ddev.site

# URL prefix of the Filament panel (default: dashboard)
# SITE_PANEL_PATH=dashboard

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TEST_BANNER_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# database (default) or meilisearch; with meilisearch the DDEV meilisearch service is at http://meilisearch:7700
FILAGORA_SEARCH_ENGINE=database

# --- Production settings the live site reads (same names as lara-forum, so its values carry over) ---
# Proxies whose X-Forwarded-* headers are trusted (client IP, HTTPS): "*" or a comma-separated list.
TRUSTED_PROXIES=
# Hosts this app answers to, comma-separated; empty enforces nothing.
APP_TRUSTED_HOSTS=
# Seconds a web request's database statement may run (0 disables); session time zone for TIMESTAMPs.
DB_MAX_STATEMENT_TIME=15
# DB_TIMEZONE=+00:00
# Redis databases for sessions and rate limiter counters, kept off the cache database so a deploy's
# cache flush cannot log everyone out or reset a lockout. Set CACHE_LIMITER_STORE=limiter to use it.
REDIS_SESSION_DB=2
REDIS_LIMITER_DB=3
CACHE_LIMITER_STORE=
# Seconds shared caches may hold a plugin version-check answer.
PLUGINS_VERSIONCHECK_CACHE_TTL_SECONDS=900
# Dashboard pages that run fail2ban-client and nftables through a wrapper.
FAIL2BAN_ENABLED=false
NFTABLES_ENABLED=false
