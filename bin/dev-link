#!/usr/bin/env bash
# Use the local Filagora checkouts (../filagora-*) instead of the GitHub versions, so a
# change in a package shows up here at once. Run inside the project; needs DDEV and nothing
# else (the composer.json edit is done by Composer itself).
#
# This edits composer.json and composer.lock. Do not commit those changes: run
# bin/dev-unlink first.
set -euo pipefail
cd "$(dirname "$0")/.."

# A symlinked checkout reports itself as dev-master, which would not satisfy the packages'
# own ^0.x constraints on each other, so each is given the release line it stands for.
# Bump a line when a package moves to a new 0.x minor.
declare -A lines=(
  [core]=0.2.x-dev
  [entitlements]=0.2.x-dev
  [forums]=0.6.x-dev
  [logs]=0.3.x-dev
  [cms]=0.3.x-dev
  [compliance]=0.1.x-dev
  [messages]=0.3.x-dev
  [search]=0.2.x-dev
  [push]=0.1.x-dev
  [memberships]=0.1.x-dev
  [notifications]=0.1.x-dev
  [plugins]=0.3.x-dev
  [plugins-security]=0.1.x-dev
  [zencart]=0.13.x-dev
)

for name in "${!lines[@]}"; do
  if [ ! -d "../filagora-${name}" ]; then
    echo "Missing ../filagora-${name}: clone it next to this project first." >&2
    exit 1
  fi
done

ddev restart >/dev/null

# Composer puts a new repository ahead of Packagist, so the local copy is preferred. The path
# is where DDEV mounts the sibling checkouts inside the container.
requires=()
for name in "${!lines[@]}"; do
  ddev composer config "repositories.filagora-${name}" \
    "{\"type\":\"path\",\"url\":\"/var/www/filagora-${name}\",\"options\":{\"symlink\":true,\"versions\":{\"filagora/filagora-${name}\":\"${lines[$name]}\"}}}"
  requires+=("filagora/filagora-${name}:@dev")
done

ddev composer require --no-interaction "${requires[@]}"

echo
echo "Linked. vendor/filagora/ now points at your checkouts:"
ls -l vendor/filagora
